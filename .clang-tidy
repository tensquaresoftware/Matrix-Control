# Matrix-Control quality gate — mechanical thresholds (see CONVENTIONS.md §3).
# Primary gate for day-to-day work: Scripts/quality/lint_touched.py (git diff).
# This file aligns clang-tidy / IDE analysis with the same numbers.
#
# Real-time audio path: safety beats aesthetics. Prefer a dated NOLINT with motive
# over fragmenting processBlock for the linter.

Checks: >
  -*,
  readability-function-size,
  readability-function-cognitive-complexity

HeaderFilterRegex: 'Source/.*'

WarningsAsErrors: ''

CheckOptions:
  # ~50 lines covers UI/glue; Core logic should stay nearer ~40 (script enforces path-aware limits).
  - key: readability-function-size.LineThreshold
    value: '50'
  - key: readability-function-size.StatementThreshold
    value: '4294967295'
  - key: readability-function-size.BranchThreshold
    value: '4294967295'
  - key: readability-function-size.ParameterThreshold
    value: '4'
  - key: readability-function-size.NestingThreshold
    value: '4'
  - key: readability-function-size.VariableThreshold
    value: '4294967295'
  # Cognitive complexity ≈ cyclomatic for gate purposes; UI may use 12 via NOLINT if needed.
  - key: readability-function-cognitive-complexity.Threshold
    value: '10'
  - key: readability-function-cognitive-complexity.DescribeBasicIncrements
    value: 'false'
